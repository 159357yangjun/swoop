      "name": "提交已选资源",
      "scope": "workspace",
      "frequency": "medium",
      "risk": "medium",
      "effect": "mutate",
      "recovery": "cancel",
      "task_ids": [
        "T-P2"
      ],
      "entrypoints": [
        {
          "screen_id": "S-popup",
          "region_id": "R-popup-batch",
          "surface": "toolbar",
          "menu_depth": 0,
          "context": "已经选中至少一个资源"
        }
      ],
      "feedback": [
        "loading",
        "success",
        "failure",
        "unknown"
      ]
    },
    {
      "id": "A-check-connection",
      "name": "检查桌面端连接",
      "scope": "workspace",
      "frequency": "medium",
      "risk": "low",
      "effect": "read",
      "recovery": "retry",
      "task_ids": [
        "T-P3"
      ],
      "entrypoints": [
        {
          "screen_id": "S-popup",
          "region_id": "R-popup-status",
          "surface": "inline",
          "menu_depth": 0,
          "context": "连接状态处发现断连；既有设置中可重新检测"
        }
      ],
      "feedback": [
        "loading",
        "success",
        "failure",
        "unknown"
      ]
    },
    {
      "id": "A-open-diagnostics",
      "name": "逐步排查 Native Host 连接",
      "scope": "workspace",
      "frequency": "medium",
      "risk": "low",
      "effect": "read",
      "recovery": "not-needed",
      "task_ids": [
        "T-P3"
      ],
      "entrypoints": [
        {
          "screen_id": "S-diagnostics",
          "region_id": "R-diag-steps",
          "surface": "inline",
          "menu_depth": 0,
          "context": "G2 待实现：从断连提示进入同一 Popup 内诊断面板"
        }
      ],
      "feedback": [
        "loading",
        "success",
        "failure",
        "unknown"
      ]
    },
    {
      "id": "A-refresh-handoff",
      "name": "只读核对原下载请求状态",
      "scope": "workspace",
      "frequency": "low",
      "risk": "low",
      "effect": "read",
      "recovery": "not-needed",
      "task_ids": [
        "T-P4"
      ],
      "entrypoints": [
        {
          "screen_id": "S-popup",
          "region_id": "R-popup-handoff",
          "surface": "inline",
          "menu_depth": 0,
          "context": "出现最近转交记录或未确认提示后手动刷新"
        }
      ],
      "feedback": [
        "loading",
        "success",
        "failure",
        "unknown"
      ]
    }
  ],
  "design_evidence": {
    "wireframe": "UI-01-WIREFRAME.md",
    "task_walkthrough": "UI-01-TASK-WALKTHROUGH.md",
    "decision_log": "UI-01-DECISIONS.md"
  },
  "test_plan": {
    "viewport_sizes": [
      "Windows 1366×768（100% DPI）",
      "Windows 1920×1080（125% / 150% DPI）",
      "Chrome/Edge Popup 400×560（含窄窗口缩放）"
