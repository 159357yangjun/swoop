{
  "manifest_version": 3,
  "name": "Swoop Radar",
  "version": "0.2.0",
  "description": "用 Swoop 接管浏览器下载，并扫描当前页面的可下载资源",
  "permissions": [
    "downloads",
    "nativeMessaging",
    "contextMenus",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Swoop Radar",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
